# Pinned SDL releases. Stable SDL releases use an even minor version (3.2.x, 3.4.x).
# Bump to the latest stable releases with: ./scripts/update-versions.sh
SDL=release-3.4.18
SDL_IMAGE=release-3.4.8
SDL_TTF=release-3.2.2
SDL_MIXER=release-3.2.4

# Build options. Override per machine in .env.local (gitignored) or in the environment,
# e.g. PREFIX=$HOME/.local ./setup.sh
PREFIX=/usr/local
BUILD_TYPE=Release
LIBS="SDL SDL_image SDL_ttf SDL_mixer"
